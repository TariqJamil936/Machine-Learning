    <h1>ydata-profiling</h1>

    <div class="badges">
        <img src="https://img.shields.io/badge/pypi-v4.6.0-blue" alt="PyPI">
        <img src="https://img.shields.io/badge/python-3.8%2B-blue" alt="Python">
